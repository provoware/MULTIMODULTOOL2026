QWidget {
    background: #061019;
    color: #e9f2f7;
    font-family: "Noto Sans", "DejaVu Sans", sans-serif;
    font-size: 14px;
}
QMainWindow { background: #040a10; }

QFrame#header,
QFrame#footer,
QFrame#navigation,
QFrame#contextRail,
QFrame#panel,
QFrame#workflowPanel,
QFrame#actionBar,
QFrame#card,
QFrame#diagnosticsCenter {
    background: #0a1620;
    border: 1px solid #294657;
    border-radius: 10px;
}
QFrame#header { background: #08161b; border-color: #1d6070; }
QFrame#footer { background: #08151a; color: #b9c9d2; }
QFrame#navigation { background: #08131d; }
QFrame#contextRail { background: #08131b; }
QFrame#hero {
    background: #0c1e28;
    border: 1px solid #00a9c0;
    border-radius: 10px;
}
QFrame#warningPanel {
    background: #20190b;
    border: 1px solid #a97821;
    border-radius: 10px;
}

QLabel#appTitle { font-size: 21px; font-weight: 800; letter-spacing: 1px; }
QLabel#sectionTitle,
QLabel#cardValue { font-size: 16px; font-weight: 750; }
QLabel#navTitle {
    color: #8fa7b5;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
}
QLabel#muted { color: #a8bac5; }
QLabel#smallMuted { color: #8299a7; font-size: 12px; }
QLabel#statusOk { color: #54ef9b; font-weight: 800; }

QPushButton,
QComboBox,
QLineEdit {
    background: #0d1c27;
    border: 1px solid #355668;
    border-radius: 8px;
    padding: 9px 13px;
}
QPushButton { text-align: left; }
QPushButton:hover,
QComboBox:hover,
QLineEdit:hover { background: #132a38; border-color: #00dff5; }
QPushButton:focus,
QComboBox:focus,
QLineEdit:focus,
QListWidget:focus,
QPlainTextEdit:focus {
    border: 2px solid #f6d04f;
}
QPushButton:disabled {
    background: #09131b;
    color: #60727e;
    border-color: #263b47;
}
QPushButton[active="true"] {
    background: #102b36;
    border-color: #00dff5;
    color: #ffffff;
    font-weight: 750;
}

QProgressBar {
    background: #061019;
    border: 1px solid #355668;
    border-radius: 7px;
    min-height: 20px;
    text-align: center;
    font-weight: 700;
}
QProgressBar::chunk { background: #00cfe8; border-radius: 6px; }

QScrollArea#workspaceScroll,
QScrollArea#contextScroll {
    background: transparent;
    border: none;
}
QScrollArea#workspaceScroll > QWidget > QWidget,
QScrollArea#contextScroll > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { background: #071019; width: 10px; margin: 0; }
QScrollBar::handle:vertical {
    background: #355668;
    border-radius: 5px;
    min-height: 28px;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }

QFrame#diagnosticsCenter {
    background: #07151e;
    border-color: #2c6476;
    padding: 4px;
}
QListWidget#diagnosticsList,
QPlainTextEdit#diagnosticsDetail {
    background: #050e15;
    border: 1px solid #294657;
    border-radius: 8px;
    selection-background-color: #145266;
    selection-color: #ffffff;
}
QListWidget#diagnosticsList::item {
    border-bottom: 1px solid #173242;
    padding: 8px;
}
QListWidget#diagnosticsList::item:selected { background: #103849; }
QPushButton#diagnosticsCopyButton { border-color: #00dff5; }
QLabel#diagnosticsStatus { color: #9eb2bf; }

QToolTip {
    background: #132631;
    color: #f1f7fa;
    border: 1px solid #5e8092;
    padding: 6px;
}

QDialog#globalErrorDialog {
    background: #08131b;
    border: 2px solid #ff626c;
}
QFrame#errorField {
    background: #0b1822;
    border: 1px solid #3a5362;
    border-radius: 8px;
}
QLabel#errorDialogTitle { color: #ff8c93; font-size: 20px; font-weight: 850; }
QLabel#errorDialogSummary { color: #c3d2da; font-size: 13px; }
QLabel#errorFieldCaption {
    color: #8fa7b5;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
}
QLabel#errorDiagnosticId {
    color: #f6d04f;
    font-family: "DejaVu Sans Mono", monospace;
    font-weight: 800;
}
QPushButton#copyErrorReport { border-color: #00dff5; }
QPushButton#closeErrorDialog { border-color: #54ef9b; }
